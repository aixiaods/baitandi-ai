.page { position: relative; width: 100vw; height: 100vh; overflow: hidden; }
.map { width: 100%; height: 100%; }

/* 顶部搜索框 */
.search-bar {
  position: absolute;
  top: 0; left: 0; right: 0;
  padding: 20rpx 24rpx 0;
  z-index: 30;
}
.search-inner {
  background: #1C2A38;
  border-radius: 20rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 80rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.4);
}
.search-icon-text { font-size: 28rpx; flex-shrink: 0; }
.search-input { flex: 1; font-size: 28rpx; color: #fff; height: 80rpx; }
.search-clear { font-size: 24rpx; color: rgba(255,255,255,0.4); padding: 8rpx; }

.search-results {
  background: #1C2A38;
  border-radius: 16rpx;
  margin-top: 8rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.4);
  max-height: 480rpx;
}
.search-result-item {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.06);
}
.search-result-item:last-child { border-bottom: none; }
.result-title { font-size: 28rpx; color: #fff; font-weight: 500; }
.result-addr { font-size: 22rpx; color: rgba(255,255,255,0.4); margin-top: 4rpx; }

.pin-wrap {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -100%);
  pointer-events: none;
  z-index: 10;
}
.pin { font-size: 64rpx; line-height: 1; }

.addr-card {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  background: #1C2A38;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 40rpx rgba(0,0,0,0.4);
  z-index: 20;
}
.addr-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.addr-icon { font-size: 40rpx; flex-shrink: 0; margin-top: 4rpx; }
.addr-name { font-size: 32rpx; font-weight: 600; color: #fff; margin-bottom: 8rpx; line-height: 1.4; }
.addr-detail { font-size: 24rpx; color: rgba(255,255,255,0.45); line-height: 1.4; }
.addr-tip { font-size: 24rpx; color: rgba(255,255,255,0.3); text-align: center; margin-bottom: 24rpx; }
.addr-loading { color: var(--theme); }
.addr-placeholder { color: rgba(255,255,255,0.2); }

.btn-confirm {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 50rpx;
  background: var(--theme);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 6rpx 24rpx rgba(255,107,53,0.35);
  text-align: center;
}
.btn-disabled { background: #4A3028; color: rgba(255,255,255,0.3); box-shadow: none; }
