.page {
  min-height: 100vh;
  background: #0F1923;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 顶部导航栏 */
.topbar {
  background: #162030;
  border-bottom: 1rpx solid rgba(255,255,255,0.06);
  padding: 0 40rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}
.topbar-title {
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.9);
  letter-spacing: 2rpx;
}
.theme-btn {
  font-size: 44rpx;
  padding: 8rpx;
}

/* 主题色弹窗 */
.theme-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
}
.theme-panel {
  position: fixed;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  left: 32rpx; right: 32rpx;
  background: #1C2A38;
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  z-index: 201;
  border: 1rpx solid rgba(255,255,255,0.08);
}
.theme-panel-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 32rpx;
  text-align: center;
}
.theme-colors {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.theme-color-item {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.theme-color-active {
  box-shadow: 0 0 0 4rpx rgba(255,255,255,0.8);
}
.theme-check {
  font-size: 32rpx;
  color: #fff;
  font-weight: 700;
}
.theme-labels {
  display: flex;
  justify-content: space-between;
}
.theme-label {
  width: 80rpx;
  text-align: center;
  font-size: 20rpx;
  color: rgba(255,255,255,0.4);
}

/* 雷达区域 */
.radar-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0 24rpx;
}

/* 科技感标题 */
.radar-title-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}
.radar-title {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 10rpx;
  line-height: 1.1;
}
.title-normal {
  color: rgba(255,255,255,0.75);
  font-weight: 300;
  letter-spacing: 8rpx;
}
.title-accent {
  color: var(--theme);
  font-weight: 800;
  letter-spacing: 8rpx;
  text-shadow: 0 0 20rpx var(--theme);
}
.radar-title-sub {
  font-size: 22rpx;
  color: rgba(255,255,255,0.35);
  letter-spacing: 1rpx;
  margin-top: 10rpx;
}
.radar-title-line {
  width: 80rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--theme), transparent);
  margin-top: 14rpx;
}

.radar-bg {
  position: relative;
  width: 480rpx;
  height: 480rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 同心圆 */
.circle {
  position: absolute;
  border-radius: 50%;
  border: 1rpx solid var(--theme);
  opacity: 0.25;
}
.c1 { width: 160rpx; height: 160rpx; opacity: 0.35; }
.c2 { width: 300rpx; height: 300rpx; opacity: 0.2; }
.c3 { width: 440rpx; height: 440rpx; opacity: 0.1; }

/* 扫描扇形 */
.radar-scan {
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: conic-gradient(
    from 0deg,
    transparent 0deg,
    transparent 270deg,
    rgba(255,255,255,0.06) 270deg,
    rgba(255,255,255,0.2) 360deg
  );
  transform-origin: center;
  box-shadow: inset 0 0 0 0 transparent;
}
/* 用伪元素叠加主题色光晕 */
.radar-scan::after {
  content: '';
  position: absolute;
  right: 0; top: 0;
  width: 50%; height: 50%;
  background: var(--theme);
  opacity: 0.18;
  border-radius: 0 100% 0 0;
  transform-origin: 0% 100%;
}
.scanning { animation: radarSpin 3s linear infinite; }
.scanning-fast { animation: radarSpin 1s linear infinite; }
@keyframes radarSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 中心点 */
.radar-center {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
}
.center-dot {
  width: 20rpx;
  height: 20rpx;
  background: var(--theme);
  border-radius: 50%;
  z-index: 2;
}
.center-ring {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid var(--theme);
  opacity: 0.5;
  border-radius: 50%;
  animation: ringPulse 1.5s ease-out infinite;
}
@keyframes ringPulse {
  0% { transform: scale(1); opacity: 1; }
  100% { transform: scale(3); opacity: 0; }
}

/* 状态文字 */
.radar-status {
  margin-top: 32rpx;
  text-align: center;
  min-height: 80rpx;
}
.status-idle { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.status-text { font-size: 28rpx; color: rgba(255,255,255,0.7); }
.scanning-text { color: var(--theme); font-weight: 600; }
.status-sub { font-size: 22rpx; color: rgba(255,255,255,0.35); margin-top: 8rpx; }

/* 按钮 */
.btn-area { padding: 32rpx 48rpx 0; flex-shrink: 0; }
.btn-scan {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 50rpx;
  background: var(--theme);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 40rpx rgba(255,107,53,0.4);
}

/* 弹窗遮罩 */
.popup-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}

/* 底部弹窗 */
.popup {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #1C2A38;
  border-radius: 40rpx 40rpx 0 0;
  padding: 0 32rpx calc(140rpx + env(safe-area-inset-bottom));
  z-index: 101;
  max-height: 85vh;
  overflow-y: auto;
}
.popup-handle {
  width: 80rpx;
  height: 8rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 4rpx;
  margin: 20rpx auto 0;
}
.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
}
.popup-title { font-size: 32rpx; font-weight: 700; color: #fff; }
.popup-close {
  width: 56rpx;
  height: 56rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
}
.card-header {
  display: flex;
  gap: 24rpx;
  align-items: center;
  margin-bottom: 24rpx;
}
.score-circle {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 6rpx solid var(--theme);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.score-num { font-size: 44rpx; font-weight: 800; line-height: 1; }
.score-label { font-size: 20rpx; color: #888; }
.card-header-right { flex: 1; display: flex; flex-direction: column; gap: 10rpx; }
.verdict-badge {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 20rpx;
  border-radius: 50rpx;
  align-self: flex-start;
}
.card-spot { font-size: 26rpx; color: var(--theme); font-weight: 600; }
.card-crowd { font-size: 24rpx; color: rgba(255,255,255,0.5); }
.card-reason {
  background: rgba(255,255,255,0.05);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.reason-text { font-size: 26rpx; color: rgba(255,255,255,0.8); line-height: 1.6; }
.card-time { font-size: 24rpx; color: rgba(255,255,255,0.6); margin-bottom: 16rpx; }
.tags-row { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 16rpx; }
.tag-item {
  padding: 6rpx 18rpx;
  background: rgba(255,107,53,0.15);
  color: var(--theme);
  border-radius: 50rpx;
  font-size: 24rpx;
  border: 1rpx solid rgba(255,107,53,0.3);
}
.risk-bar {
  display: flex;
  gap: 12rpx;
  background: rgba(243,156,18,0.1);
  border-left: 4rpx solid #F39C12;
  padding: 14rpx 16rpx;
  border-radius: 0 12rpx 12rpx 0;
  margin-bottom: 24rpx;
  font-size: 24rpx;
}
.risk-text { color: rgba(255,255,255,0.6); line-height: 1.5; }
.popup-actions { display: flex; flex-direction: column; gap: 16rpx; }
.popup-actions-row { display: flex; gap: 16rpx; }
.btn-save {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 50rpx;
  background: rgba(255,255,255,0.08);
  border: 2rpx solid rgba(255,255,255,0.15);
  color: rgba(255,255,255,0.7);
  font-size: 26rpx;
}
.btn-saved {
  background: rgba(46,204,113,0.15);
  border-color: #2ECC71;
  color: #2ECC71;
}
.btn-full-eval {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 50rpx;
  background: linear-gradient(135deg, var(--theme), #FF9A6C);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}
.btn-rescan-sm {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 50rpx;
  background: transparent;
  border: 2rpx solid rgba(255,255,255,0.2);
  color: rgba(255,255,255,0.5);
  font-size: 26rpx;
}
