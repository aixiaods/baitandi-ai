.page { background: #0F1923; min-height: 100vh; padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 48rpx 0;
}
.empty-icon { font-size: 100rpx; margin-bottom: 32rpx; }
.empty-text { font-size: 36rpx; font-weight: 600; color: #fff; margin-bottom: 16rpx; }
.empty-sub { font-size: 26rpx; color: rgba(255,255,255,0.4); }

.list-wrap { padding: 24rpx 24rpx 0; }

.report-card {
  background: #1C2A38;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(255,255,255,0.06);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.card-body {
  display: flex;
  gap: 28rpx;
  align-items: center;
  padding: 32rpx;
}
.card-footer {
  border-top: 1rpx solid rgba(255,255,255,0.06);
  display: flex;
  justify-content: flex-end;
}
.card-delete-btn {
  padding: 16rpx 32rpx;
  font-size: 24rpx;
  color: rgba(231,76,60,0.8);
}
.card-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(135deg, var(--theme), #FF9A6C);
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  color: #fff;
  flex-shrink: 0;
}
.card-score { font-size: 52rpx; font-weight: 800; line-height: 1; }
.card-score-label { font-size: 22rpx; opacity: 0.85; }

.card-right { flex: 1; overflow: hidden; }
.card-summary {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.card-meta { font-size: 24rpx; color: rgba(255,255,255,0.45); margin-bottom: 8rpx; }
.card-time { font-size: 22rpx; color: rgba(255,255,255,0.25); }

.btn-primary {
  background: var(--theme);
  color: #fff;
  border-radius: 50rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
  width: 100%;
}
