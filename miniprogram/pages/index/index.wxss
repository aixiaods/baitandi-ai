.page {
  min-height: 100vh;
  padding: 0 32rpx calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: #0F1923;
}

/* 头部 */
.hero {
  padding: 48rpx 0 36rpx;
  text-align: center;
}
.hero-badge {
  display: inline-block;
  font-size: 22rpx;
  color: var(--theme);
  background: rgba(255,107,53,0.12);
  border: 1rpx solid rgba(255,107,53,0.3);
  border-radius: 50rpx;
  padding: 6rpx 24rpx;
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
}
.hero-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 16rpx;
  line-height: 1.2;
}
.hero-highlight { color: var(--theme); }
.hero-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.4);
  letter-spacing: 1rpx;
}

/* 功能卡片网格 */
.feature-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 40rpx;
}
.feature-card {
  background: #1C2A38;
  border-radius: 24rpx;
  padding: 36rpx 24rpx;
  border: 1rpx solid rgba(255,255,255,0.06);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
}
.feature-card-icon { font-size: 52rpx; }
.feature-card-name { font-size: 30rpx; font-weight: 700; color: #fff; }
.feature-card-sub { font-size: 24rpx; color: rgba(255,255,255,0.4); }

.btn-wrap { margin-bottom: 20rpx; }
.btn-primary {
  background: var(--theme);
  color: #fff;
  border-radius: 50rpx;
  border: none;
  font-size: 32rpx;
  font-weight: 600;
  height: 96rpx;
  line-height: 96rpx;
  width: 100%;
  box-shadow: 0 8rpx 32rpx rgba(255,107,53,0.4);
  letter-spacing: 2rpx;
}
.tip { text-align: center; font-size: 24rpx; color: rgba(255,255,255,0.2); }
