.tabbar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  height: 100rpx;
  background: #162030;
  display: flex;
  border-top: 1rpx solid rgba(255,255,255,0.06);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}
.tab-icon { font-size: 40rpx; line-height: 1; }
.tab-text { font-size: 20rpx; color: #8A9BB0; }
.tab-active .tab-text { color: var(--theme); }
